{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://memlens.dev/protocol/1.4.0/schema.json",
  "title": "MemLens protocol 1.4.0",
  "definitions": {
    "fidelity": { "enum": ["static", "traced", "debugger"] },
    "sourceRange": {
      "type": "object",
      "required": ["uri", "startLine", "startCol", "endLine", "endCol"],
      "properties": {
        "uri": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 0 },
        "startCol": { "type": "integer", "minimum": 0 },
        "endLine": { "type": "integer", "minimum": 0 },
        "endCol": { "type": "integer", "minimum": 0 }
      }
    },
    "fieldLayout": {
      "type": "object",
      "required": ["name", "type", "offset", "size", "align", "paddingAfter"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "offset": { "type": "integer", "minimum": 0 },
        "size": { "type": "integer", "minimum": 0 },
        "align": { "type": "integer", "minimum": 0 },
        "paddingAfter": { "type": "integer", "minimum": 0 }
      }
    },
    "block": {
      "type": "object",
      "required": ["id", "name", "type", "sourceRange", "lifetime", "confidence", "fidelity"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sizeSymbolic": { "type": "string" },
        "address": { "type": "string" },
        "pointsTo": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["targetId"],
            "properties": {
              "targetId": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "kind": { "enum": ["points-to", "owns", "borrows", "references", "aliases", "contains"] },
              "confidence": { "enum": ["measured", "debugger", "static", "inferred"] },
              "source": { "enum": ["compiler", "runtime", "debugger", "heuristic"] }
            }
          }
        },
        "sourceRange": { "$ref": "#/definitions/sourceRange" },
        "lifetime": {
          "type": "object",
          "required": ["start", "scopeBound"],
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" },
            "scopeBound": { "type": "boolean" }
          }
        },
        "layout": { "type": "array", "items": { "$ref": "#/definitions/fieldLayout" } },
        "layoutSource": { "enum": ["compiler", "fallback"] },
        "totalSizeBytes": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "fidelity": { "$ref": "#/definitions/fidelity" }
      },
      "oneOf": [{ "required": ["sizeBytes"] }, { "required": ["sizeSymbolic"] }]
    },
    "memoryEvent": {
      "type": "object",
      "required": ["seq", "kind", "addr", "size", "thread", "stack", "timestamp"],
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["alloc", "free", "realloc", "write"] },
        "addr": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" },
        "size": { "type": "integer", "minimum": 0 },
        "thread": { "type": "string" },
        "stack": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["function", "file", "line"],
            "properties": {
              "function": { "type": "string" },
              "file": { "type": "string" },
              "line": { "type": "integer", "minimum": 0 },
              "col": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "timestamp": { "type": "number" }
      }
    }
  },
  "type": "object"
}
